@echo off
REM ================================================================================
REM 测试损坏的BLF文件解析功能
REM ================================================================================

echo.
echo ========================================================================
echo BLF 文件解析错误处理测试
echo ========================================================================
echo.
echo 此测试将验证以下功能：
echo   1. 部分解析成功时，正确结果显示在logs和折线图上
echo   2. 错误信息显示在右下角状态栏
echo   3. 控制台输出详细的错误信息
echo.
echo ========================================================================
echo.

REM 检查测试文件是否存在
if not exist "test_corrupted.blf" (
    echo ❌ 错误：找不到测试文件 test_corrupted.blf
    echo.
    echo 正在生成测试文件...
    cd src\blf
    cargo run --bin gen_corrupted_blf
    cd ..\..

    if exist "src\blf\test_corrupted.blf" (
        copy /Y "src\blf\test_corrupted.blf" "." >nul
        echo ✅ 测试文件已生成
    ) else (
        echo ❌ 无法生成测试文件
        pause
        exit /b 1
    )
)

echo ✅ 找到测试文件: test_corrupted.blf
echo.

REM 运行命令行测试
echo ========================================================================
echo 第1步：命令行解析测试
echo ========================================================================
echo.
cd src\blf
cargo run --bin test_corrupted
cd ..\..

echo.
echo ========================================================================
echo 第2步：启动GUI应用进行交互式测试
echo ========================================================================
echo.
echo 请按照以下步骤操作：
echo.
echo 1. 应用启动后，点击顶部菜单栏的 "Open BLF" 按钮
echo 2. 选择 test_corrupted.blf 文件
echo 3. 观察以下内容：
echo.
echo    ✅ Logs视图应该显示 20 个CAN消息
echo    ✅ 右下角状态栏应显示：
echo       "BLF 解析完成: 20 对象成功 ^| X 个错误 (首个: ...)"
echo    ✅ 控制台应输出详细的错误信息
echo.
echo ========================================================================
echo.

REM 检查是否编译了GUI应用
if exist "target\debug\canview.exe" (
    echo 正在启动 canview 应用...
    echo.
    cargo run
) else (
    echo 首次运行，正在编译 canview 应用...
    echo 这可能需要一些时间...
    echo.
    cargo run
)

echo.
echo ========================================================================
echo 测试完成！
echo ========================================================================
echo.
pause
