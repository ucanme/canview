# Default: normalize line endings to LF on commit
* text=auto

# Shell scripts must always use LF
*.sh text eol=lf

# Windows-only scripts use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Inno Setup scripts use CRLF (Windows tool)
*.iss text eol=crlf
*.isl text eol=crlf

# Binary files
*.exe binary
*.dll binary
*.ico binary
*.png binary
*.jpg binary
*.gif binary
